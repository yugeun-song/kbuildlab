# What this tree is.  Read by every kbuildlab command; never inferred from the
# directory name, so renaming the directory cannot change what gets built.
NAME=@NAME@
ARCH=@ARCH@

# The tag or branch to track.  A tag is pinned and `kbuildlab sync` will say so.
# A stable branch such as linux-6.12.y moves as patches land, which is what
# makes `kbuildlab update` meaningful.
VERSION=@VERSION@
UPSTREAM=stable          # stable | mainline

# Where the kernel source lives inside this tree.  Left unset, kbuildlab finds
# it by content (the single kernel source root among the children) and clones
# into 'kernel'.  Set it only to disambiguate more than one source, or to clone
# into a differently named directory: SRC_DIR=dummy

# Root filesystem for `kbuildlab run`, handed to the kernel as an initramfs.  A
# path, absolute or relative to this tree.  Without it the guest panics at
# mount-root once continued, so set it to boot to a login shell (or pass
# --no-initrd for early-boot debugging that never needs userspace):
# INITRD=../rootfs/<arch>/images/rootfs.cpio.gz

# QEMU.  Filled in by the arch template; edit freely.

# The kernel image base is deliberately NOT stated here.
#
# On riscv64 it cannot be: arch/riscv/mm/init.c reads `kernel_map.phys_addr =
# (uintptr_t)(&_start)` PC-relatively before the MMU is on, and vmlinux.lds.S
# links at a virtual address, so no physical base exists in the image to read.
# The only guarantee is alignment -- 2MB for rv64, enforced by a BUG_ON in
# mm/init.c -- and 0x80200000 is a loader convention, not a property of the
# kernel.  arm64 and x86_64 are more predictable but not more principled.
#
# So the debugger measures it.  If you need to pin it for a target that cannot
# be introspected, add GDBTOOLS_ENTRY_PA here and say where the number came
# from; a number whose provenance is "it worked last time" is how a session ends
# up calibrated to the wrong address with nothing reporting it.
