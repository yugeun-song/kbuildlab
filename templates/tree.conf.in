# What this tree is.  Read by every kbuildlab command; never inferred from the
# directory name, so renaming the directory cannot change what gets built.
NAME=@NAME@
ARCH=@ARCH@

# The tag or branch to track.  A tag is pinned and `kbuildlab sync` will say so.
# A stable branch such as linux-6.12.y moves as patches land, which is what
# makes `kbuildlab update` meaningful.
VERSION=@VERSION@
UPSTREAM=stable          # stable | mainline

# The kernel source this tree builds and boots, an absolute path.  `sync` clones
# into it when it does not exist yet; `kbuildlab mv` moves it and updates this.
SRC=@SRC@

# Paths below are absolute, ~/-relative, or relative to the tree's data directory
# (`kbuildlab inspect <name> --format data` names it), where its boot disks,
# persistent disk and module archive live.  kbuildlab's own records never go into
# the source.

# Root filesystem for `kbuildlab run`, handed to the kernel as an initramfs.
# Without it the guest panics at mount-root once continued, so set it to boot to
# a login shell (or pass --no-initrd for early-boot debugging that never needs
# userspace):
# INITRD=/path/to/rootfs/<arch>/images/rootfs.cpio.gz

# Toolchain.  Both optional.  IMAGE names the container image this tree builds
# in, GCC the compiler version inside it; unset means the default image and its
# own unversioned gcc.  They exist because the newest compiler is not one answer
# across kernels of different ages -- gcc-10 turned -fno-common on by default and
# a pre-5.6 kernel does not link under it -- so a tree with a reason to pin one
# says so here, where the rest of its build is described.  Find the value by
# building, not by assuming; `kbuildlab containers` reports a tree whose objects
# came from a different compiler than the one named here.
# IMAGE=kbuildlab-legacy:latest
# GCC=13
# HOSTCC_FLAGS is appended to HOSTCC and reaches the host tools only, never the
# kernel's own objects.  One real use: -fcommon, which lets a pre-5.6 kernel's
# host tools link under gcc-10 and later.
# HOSTCC_FLAGS=-fcommon
#
# KCFLAGS is appended after everything the kernel's own Makefile set, so it wins
# where the two conflict -- the way to undo a flag the kernel hard-codes without
# editing it.  Keep it to debug-information flags, which gcc guarantees do not
# change code generation; anything that changes the objects belongs in the
# config, where the read-back check can see it.
# KCFLAGS=-fvar-tracking-assignments

# QEMU.  Filled in by the arch template; edit freely.
#
# Two ports, and each is a number this file STATES rather than one the tool
# derives.  GDB_PORT is where the gdbstub listens; QMP_PORT is where the QEMU
# Machine Protocol does, which is drgn's way into a running guest.  `run`
# advances past a busy port and says so, so these are defaults and not
# reservations -- but an unstated one is an error, not a guess, because a port
# computed from another port is a contract nobody wrote down.

# The kernel image base is deliberately NOT stated here.
#
# On riscv64 it cannot be: arch/riscv/mm/init.c reads `kernel_map.phys_addr =
# (uintptr_t)(&_start)` PC-relatively before the MMU is on, and vmlinux.lds.S
# links at a virtual address, so no physical base exists in the image to read.
# The only guarantee is alignment -- 2MB for rv64, enforced by a BUG_ON in
# mm/init.c -- and 0x80200000 is a loader convention, not a property of the
# kernel.  arm64 and x86_64 are more predictable but not more principled.
#
# So the debugger measures it.  If you need to pin it for a target that cannot
# be introspected, add GDBTOOLS_ENTRY_PA here and say where the number came
# from; a number whose provenance is "it worked last time" is how a session ends
# up calibrated to the wrong address with nothing reporting it.

# --- syntax ------------------------------------------------------------------
# Every line here is read as  ^\s* KEY \s*=\s* VALUE , with a trailing # comment
# and trailing space stripped and one layer of surrounding double quotes removed.
# Every reader uses exactly that grammar (kbuildlab's kbl_tree_get and its
# GDBTOOLS_ passthrough, lib/treeinfo.py and lib/clangd.py), so a line that
# works in one works in all of them.  `kbuildlab set NAME KEY=VALUE` writes it.

# --- the guest's own command line --------------------------------------------
# Words appended to the kernel command line, in every boot mode: -append for a
# direct boot, `setenv bootargs` inside the generated u-boot script, and the
# `linux` line of the generated grub.cfg.  `kbuildlab run --append` adds more on
# top of this.
#
# The kernel also hands any key=value it does not recognise to init as an
# ENVIRONMENT variable (init/main.c unknown_bootoption), and init passes it on --
# which is the only place early enough to reach PID 1 itself, so a rootfs cannot
# do it.  That is what the v4.6 tree uses it for: a modern glibc registers
# rseq(2) in every process, a 2016 kernel has no such syscall, and arm64's
# do_ni_syscall answers each one with a full register dump to the console.
# CMDLINE_EXTRA=GLIBC_TUNABLES=glibc.pthread.rseq=0

# --- emulated controllers ------------------------------------------------------
# EMULATE=1 makes `kbuildlab run` attach, unless told otherwise, the controllers
# QEMU emulates that presets/soft builds drivers for: NVMe, AHCI, virtio-scsi and
# USB disks backed by nothing on the host, USB and virtio input, virtio-gpu, HDA
# and virtio sound, virtio crypto/balloon/console, a PCI UART, a watchdog that
# does nothing when it fires, three CAN controllers on one bus, and an e1000e.
# --emulate and --no-emulate decide for one run.
# EMULATE=1

# --- a u-boot boot -------------------------------------------------------------
# Where boot.scr loads the kernel image and the initramfs.  QEMU's virt machine
# has defaults; any other MACHINE states both, and RAM_BASE (hex) so `run` can
# check that they lie in the guest's RAM.
# UBOOT_LOADADDR=0x40200000
# UBOOT_RDADDR=0x48000000
# RAM_BASE=0x40000000

# --- where the gdbstub listens -----------------------------------------------
# Default 127.0.0.1.  qemu's own `-gdb tcp::N` spelling binds 0.0.0.0 AND [::],
# and a gdbstub is an unauthenticated read/write channel into the guest's memory,
# so reaching it from another machine is opt-in per tree rather than the default
# for every tree.
# GDB_BIND=127.0.0.1

# --- debugger settings passed straight through -------------------------------
# Any GDBTOOLS_* line here is exported verbatim to the debugger, so the whole of
# gdbtools' contract table is reachable from this file without touching the
# launcher, and a line here outranks what `attach` states by default.  These
# are the ones a non-QEMU board is most likely to need: GDBTOOLS_PROFILE (a JSON machine description), GDBTOOLS_DTB, GDBTOOLS_SCAN
# (a lo:hi physical range to search for the image magic), GDBTOOLS_RAM_BASE,
# GDBTOOLS_PHYS_WINDOW, GDBTOOLS_PRESET, GDBTOOLS_ANCHOR and the GDBTOOLS_X86_*
# recovery keys.  See gdbtools/README.md for what each one means; a value stated
# here that gdbtools does not read is simply ignored, so a typo is silent.
