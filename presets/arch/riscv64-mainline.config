# kbuildlab preset, riscv64 mainline half. Used instead of riscv64.config for a
# tree tracking mainline. Two things changed after 6.12:
#  - ftrace was decoupled from !PREEMPTION and now uses -fmin-function-alignment
#    dynamic ftrace (needs gcc-14+), so the stable half's forced PREEMPT_NONE is
#    both unavailable (PREEMPT_NONE now depends on ARCH_NO_PREEMPT, which riscv
#    lacks) and no longer needed -- ftrace works under the default preemptible model.
#  - KASLR (RANDOMIZE_BASE, from common.config) now depends on RELOCATABLE.

CONFIG_RELOCATABLE=y
CONFIG_FRAME_POINTER=y
# CONFIG_XIP_KERNEL is not set
CONFIG_MMU=y
CONFIG_DYNAMIC_FTRACE_WITH_ARGS=y
CONFIG_DYNAMIC_FTRACE_WITH_DIRECT_CALLS=y
