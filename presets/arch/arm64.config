# kbuildlab preset, arm64 half.  Applied after presets/common.config.

# --- frame pointers: nothing to set ------------------------------------------
# arch/arm64/Kconfig:110 selects ARCH_WANT_FRAME_POINTERS and :136 selects
# FRAME_POINTER unconditionally.  There is no unwinder choice on arm64 and no
# STACK_VALIDATION (arm64 does not select HAVE_STACK_VALIDATION), so the x86
# lines for both would be discarded here.  Their absence is the configuration.

# --- BPF trampolines, and the one option that silently removes them -----------
# arch/arm64/Kconfig:206-210 chains DYNAMIC_FTRACE_WITH_DIRECT_CALLS behind
# DYNAMIC_FTRACE_WITH_CALL_OPS behind `!CFI_CLANG`.  A CFI-hardened arm64 build
# therefore loses BPF fentry/fexit -- bpftrace `kfunc:`, libbpf BPF_PROG attach
# -- with no error anywhere; Kconfig simply stops offering the symbol.
# CONFIG_CFI_CLANG is not set
CONFIG_DYNAMIC_FTRACE_WITH_ARGS=y
CONFIG_DYNAMIC_FTRACE_WITH_CALL_OPS=y
CONFIG_DYNAMIC_FTRACE_WITH_DIRECT_CALLS=y

CONFIG_PREEMPT=y
CONFIG_PREEMPT_TRACER=y

# --- what arm64 cannot have --------------------------------------------------
# HAVE_DYNAMIC_FTRACE_WITH_REGS is absent from every arm64 Kconfig file, so
# CONFIG_FPROBE and CONFIG_KPROBES_ON_FTRACE are unreachable: kernel/trace/
# Kconfig:287-292 and arch/Kconfig:128-130 both require it.  BPF kprobe_multi is
# compiled out with FPROBE, so a bpftrace wildcard attach falls back to one
# kprobe per function.  These are not options to try; they are absent.

# --- the linear alias --------------------------------------------------------
# RODATA_FULL_DEFAULT_ENABLED (default y, arch/arm64/Kconfig:1717) makes the
# linear alias of kernel text read-only, which blocks patching text through the
# direct map -- the trick kgdb and some breakpoint schemes rely on.
# CONFIG_RODATA_FULL_DEFAULT_ENABLED is not set

# Shadow call stack keeps a second return-address stack the debugger does not
# know about, which makes an unwound backtrace disagree with reality.
# CONFIG_SHADOW_CALL_STACK is not set
