# kbuildlab preset, riscv64 half.  Applied after presets/common.config.
#
# riscv64 is the constrained one of the three.  Read the "cannot have" section
# before assuming a missing feature is a configuration mistake.

# --- preemption is mutually exclusive with ftrace -----------------------------
# arch/riscv/Kconfig:148 reads `select HAVE_FUNCTION_TRACER if !XIP_KERNEL &&
# !PREEMPTION`.  A preemptible riscv64 kernel therefore has NO ftrace at all --
# no function tracer, no function_graph, and everything built on them goes with
# it.  Kconfig does not warn; FUNCTION_TRACER simply stops being offered.
# This is why the shared fragment sets no preemption model.
CONFIG_PREEMPT_NONE=y
# CONFIG_PREEMPT is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
# PREEMPT_TRACER depends on PREEMPTION, so it cannot exist here either.
# CONFIG_PREEMPT_TRACER is not set

# --- frame pointers must be asked for ----------------------------------------
# Unlike arm64, riscv selects FRAME_POINTER only conditionally, so state it.
CONFIG_FRAME_POINTER=y

# --- preconditions, not preferences ------------------------------------------
# XIP_KERNEL costs kprobes, kretprobes, rethook, kgdb, jump labels, strict RWX
# and the mcount record.  MMU is required for dynamic ftrace.
# CONFIG_XIP_KERNEL is not set
CONFIG_MMU=y

CONFIG_DYNAMIC_FTRACE_WITH_ARGS=y
CONFIG_DYNAMIC_FTRACE_WITH_DIRECT_CALLS=y

# --- what riscv64 cannot have ------------------------------------------------
# These are absent from every riscv Kconfig file in 6.12.  Documented here so a
# missing feature reads as a known limit rather than a broken preset.
#
#   HAVE_HW_BREAKPOINT      -- no hardware breakpoints or watchpoints.  gdb
#                              `watch` degrades to a software watchpoint that
#                              single-steps the whole kernel: orders of
#                              magnitude slower, and slow enough to hide the
#                              races you were watching for.  `perf record -e
#                              mem:ADDR:w` is rejected outright.
#   HAVE_NMI, HAVE_PERF_EVENTS_NMI
#                           -- no perf-based hard lockup detector, and profiling
#                              cannot sample inside interrupts-disabled regions,
#                              so `perf top` under-attributes exactly the code
#                              you profile a lockup for.
#   HAVE_DYNAMIC_FTRACE_WITH_REGS
#                           -- shared with arm64.  No FPROBE, no
#                              KPROBES_ON_FTRACE, no BPF kprobe_multi.
#   HAVE_OBJTOOL, HAVE_RELIABLE_STACKTRACE, HAVE_LIVEPATCH
#                           -- also shared with arm64.
