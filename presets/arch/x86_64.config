# kbuildlab preset, x86_64 half.  Applied after presets/common.config.

# --- the unwinder, and why this is not in the shared fragment ----------------
# CONFIG_FRAME_POINTER cannot be set directly on x86: its `depends on` does not
# include x86, so olddefconfig discards the line.  The unwinder choice at
# arch/x86/Kconfig.debug:224 is the only route -- UNWINDER_FRAME_POINTER carries
# `select ARCH_WANT_FRAME_POINTERS` and `select FRAME_POINTER`.
#
# The trade is real and worth stating.  arch/x86/Kconfig.debug:255-259 quantifies
# it: roughly 3% more text and 5-10% slower than ORC.  What buys it back is that
# arch/x86/Makefile:225 passes -fno-asynchronous-unwind-tables unconditionally,
# so an x86_64 vmlinux has no .eh_frame and gdb has no CFI to unwind with; it
# follows the frame-pointer chain or it stops.  For a kernel whose purpose is to
# be debugged, a reliable gdb backtrace outranks a faster oops trace.
CONFIG_UNWINDER_FRAME_POINTER=y
# CONFIG_UNWINDER_ORC is not set
# CONFIG_UNWINDER_GUESS is not set
# Leaving ORC also drops HAVE_RELIABLE_STACKTRACE, which arch/x86/Kconfig:277
# selects from `UNWINDER_ORC || STACK_VALIDATION`.  Set STACK_VALIDATION to get
# it back; it must come after the unwinder line above.
CONFIG_STACK_VALIDATION=y

# --- x86-only tracing capability ---------------------------------------------
# x86_64 is the only one of the three with HAVE_DYNAMIC_FTRACE_WITH_REGS
# (arch/x86/Kconfig:222), which is what FPROBE and KPROBES_ON_FTRACE require.
# arm64 and riscv64 cannot have these at all -- see their fragments.
CONFIG_DYNAMIC_FTRACE_WITH_REGS=y
CONFIG_KPROBES_ON_FTRACE=y
CONFIG_OPTPROBES=y
CONFIG_FPROBE=y
CONFIG_FPROBE_EVENTS=y

# PREEMPT_TRACER needs PREEMPTION, which is free to enable here.  On riscv64 it
# is not: see that fragment.
CONFIG_PREEMPT=y
CONFIG_PREEMPT_TRACER=y

# --- address stability -------------------------------------------------------
# RANDOMIZE_MEMORY moves the direct map, vmalloc and vmemmap bases, so any tool
# that computes page_offset_base from vmlinux is wrong on every boot.  It
# depends on RANDOMIZE_BASE, which the shared fragment already turns off, but it
# is written here because a silent dependency is not a decision.
# CONFIG_RANDOMIZE_MEMORY is not set

# Page-table isolation gives a debugger reading CR3 in user context a view of
# the shadow tables rather than the kernel's.  Off, so what gdb reads is what
# the kernel uses.  This removes a Meltdown mitigation; it is a debugging
# kernel, not a production one.
# CONFIG_MITIGATION_PAGE_TABLE_ISOLATION is not set

# --- x86-only, deliberately off ----------------------------------------------
# MMIOTRACE faults every ioremap page to log accesses.  Enable it for a specific
# investigation, not by default.
# CONFIG_MMIOTRACE is not set
