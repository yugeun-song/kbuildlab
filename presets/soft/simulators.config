# kbuildlab preset, soft half: devices and buses the kernel simulates, so the
# code that drives them runs in a guest that has none of the hardware.
#
# Soft means each line is taken as far as the tree's own answers allow
# (lib/softconfig.py).  A symbol the .config already answers y or m keeps its
# answer; a line that would build in something the config holds as a module --
# directly, or through a `select` -- is taken as a module, or left off; a
# symbol this kernel does not define, or defines without a prompt, is skipped.
# One list therefore serves every kernel version, and a config built around
# modules keeps them.  Menus a simulator sits under are listed with it, since a
# `depends on` is not followed -- under every name a kernel has used for them.
#
# Built in wherever that holds, so a simulator is there at boot without a
# modprobe; a module reaches the guest too, appended to its initramfs by run.
#
# Left out on purpose:
#   RTC_DRV_TEST    registers RTCs that can come up as rtc0 before the board's
#                   own, and the system clock is then set from them at boot.
#   SOFT_WATCHDOG   a guest that opens /dev/watchdog and stops feeding it reboots.
#   FB_VIRTUAL      legacy fbdev; DRM_VKMS is the maintained virtual display.
#   fault injection changes what the kernel does rather than standing in for a
#                   device, and common.config keeps it off.

# --- interrupts and GPIO.  IRQ_SIM has no prompt: gpio-sim, gpio-mockup and the
# --- IIO dummy's event generator select it.  gpio-mockup says DEPRECATED in its
# --- own prompt and stays here for the selftests that still drive it.
CONFIG_GPIOLIB=y
CONFIG_GPIO_SIM=y
CONFIG_GPIO_MOCKUP=y
CONFIG_GPIO_VIRTUSER=y

# --- sensors: an IIO device instantiated through configfs
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_SW_DEVICE=y
CONFIG_IIO_SIMPLE_DUMMY=y
CONFIG_IIO_SIMPLE_DUMMY_EVENTS=y
CONFIG_IIO_SIMPLE_DUMMY_BUFFER=y

# --- buses.  i2c-stub is `depends on m` in its own Kconfig: a module or nothing.
CONFIG_I2C=y
CONFIG_I2C_STUB=m

# --- storage.  MTD_NAND is what MTD_RAW_NAND was called before 5.x.  nandsim's
# --- default chip takes the software Hamming ECC, which Kconfig does not make it
# --- select; a config written while raw NAND was off records that engine as off.
CONFIG_BLK_DEV_NULL_BLK=y
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI_DEBUG=y
CONFIG_MTD=y
CONFIG_MTD_NAND=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_NANDSIM=y
CONFIG_MTD_NAND_ECC_SW_HAMMING=y
CONFIG_MTD_MTDRAM=y
CONFIG_NVME_TARGET=y
CONFIG_NVME_TARGET_LOOP=y

# --- networking
CONFIG_PTP_1588_CLOCK=y
CONFIG_PTP_1588_CLOCK_MOCK=y
CONFIG_NETDEVSIM=y
CONFIG_DUMMY=y
CONFIG_CAN=y
CONFIG_CAN_VCAN=y
CONFIG_CAN_VXCAN=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MAC80211_HWSIM=y
CONFIG_VIRT_WIFI=y
CONFIG_IEEE802154=y
CONFIG_MAC802154=y
CONFIG_IEEE802154_DRIVERS=y
CONFIG_IEEE802154_HWSIM=y
CONFIG_IEEE802154_FAKELB=y
CONFIG_BT=y
CONFIG_BT_HCIVHCI=y
CONFIG_NFC=y
CONFIG_NFC_DIGITAL=y
CONFIG_NFC_SIM=y

# --- media: capture, mem2mem, codec, media-controller, CEC and DVB test devices.
# --- Without SUBDRV_AUTOSELECT every DVB frontend and tuner defaults to m, a
# --- hundred and forty hardware drivers nothing here uses; with it, a bridge
# --- selects the ones it needs.  vivid wants FB on some kernels.
CONFIG_FB=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUBDRV_AUTOSELECT=y
CONFIG_MEDIA_TEST_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_DVB_CORE=y
CONFIG_V4L_TEST_DRIVERS=y
CONFIG_VIDEO_VIVID=y
CONFIG_VIDEO_VIVID_CEC=y
CONFIG_VIDEO_VIMC=y
CONFIG_VIDEO_VIM2M=y
CONFIG_VIDEO_VICODEC=y
CONFIG_VIDEO_VISL=y
CONFIG_DVB_TEST_DRIVERS=y
CONFIG_DVB_VIDTV=y

# --- display
CONFIG_DRM=y
CONFIG_DRM_VKMS=y
CONFIG_DRM_VGEM=y

# --- sound
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_DRIVERS=y
CONFIG_SND_SEQUENCER=y
CONFIG_SND_DUMMY=y
CONFIG_SND_ALOOP=y
CONFIG_SND_VIRMIDI=y
CONFIG_SND_PCMTEST=y

# --- USB: a host and a device controller wired to each other, and the
# --- loopback/source-sink gadget functions to put on it
CONFIG_USB_GADGET=y
CONFIG_USB_DUMMY_HCD=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_LB_SS=y

# --- input
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID=y
CONFIG_UHID=y

# --- power, thermal, regulators, TPM
CONFIG_POWER_SUPPLY=y
CONFIG_TEST_POWER=y
CONFIG_THERMAL=y
CONFIG_THERMAL_EMULATION=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_VIRTUAL_CONSUMER=y
CONFIG_REGULATOR_USERSPACE_CONSUMER=y
CONFIG_TCG_TPM=y
CONFIG_TCG_VTPM_PROXY=y
