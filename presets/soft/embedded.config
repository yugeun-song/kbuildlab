# kbuildlab preset, soft half: the user-space interfaces of the embedded buses,
# and the drivers of the peripherals a `run --board` machine has QEMU attach to
# its I2C and SPI controllers.  Applied softly (lib/softconfig.py).
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_GPIO=y
CONFIG_SPI=y
CONFIG_SPI_SPIDEV=y
CONFIG_SPI_GPIO=y
CONFIG_GPIO_CDEV=y
CONFIG_CAN_RAW=y
CONFIG_CAN_BCM=y
CONFIG_CAN_GW=y
CONFIG_CAN_ISOTP=y
CONFIG_CAN_J1939=y
CONFIG_HWMON=y
CONFIG_SENSORS_LM75=y
CONFIG_SENSORS_TMP421=y
CONFIG_SENSORS_EMC1403=y
CONFIG_EEPROM_AT24=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_DS1307=y
CONFIG_GPIO_PCA953X=y
CONFIG_DPS310=y
CONFIG_MTD_SPI_NOR=y
