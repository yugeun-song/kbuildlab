# kbuildlab preset, soft half: what ftrace, perf and their kin need to see the
# simulated and emulated devices at work, beyond the tracers common.config
# already builds.  Each is idle until asked: a debugfs file, a tracepoint, a
# pr_debug site switched on at run time.  Applied softly (lib/softconfig.py).

# --- any driver's pr_debug and dev_dbg, switched on per call site at run time
CONFIG_DYNAMIC_DEBUG=y

# --- interrupts: /sys/kernel/debug/irq shows every domain and descriptor --
# --- irq_sim's included -- and can inject an interrupt by hand
CONFIG_GENERIC_IRQ_DEBUGFS=y

# --- scheduling: the sched_stat_* tracepoints `perf sched` reads exist only
# --- with SCHEDSTATS
CONFIG_SCHEDSTATS=y

# --- buses and devices
CONFIG_USB_MON=y
CONFIG_USB_GADGET_DEBUG_FS=y
CONFIG_GPIO_SYSFS=y
CONFIG_SCSI_LOGGING=y
CONFIG_BLK_DEBUG_FS=y
CONFIG_NVME_VERBOSE_ERRORS=y
CONFIG_NVME_TARGET_DEBUGFS=y

# --- network: dropped packets, generated traffic, and mac80211's own messages
# --- as trace events
CONFIG_NET_DROP_MONITOR=y
CONFIG_NET_PKTGEN=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_MAC80211_MESSAGE_TRACING=y

# --- media and sound
CONFIG_VIDEO_ADV_DEBUG=y
CONFIG_SND_DEBUG=y
CONFIG_SND_VERBOSE_PROCFS=y

# --- debug information on the kernels that still ask for it: DEBUG_INFO has a
# --- prompt there, and later kernels set it from the DWARF choice in
# --- common.config, which this line then leaves alone
CONFIG_DEBUG_INFO=y
