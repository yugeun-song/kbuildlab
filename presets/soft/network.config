# kbuildlab preset, soft half: XDP and RDMA on the emulated Ethernet ports.
# QEMU has no InfiniBand HCA, so verbs run over Soft-RoCE (rxe) and Soft-iWARP
# (siw), which attach to any netdev.  Applied softly (lib/softconfig.py).
CONFIG_XDP_SOCKETS=y
CONFIG_XDP_SOCKETS_DIAG=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_VETH=y
CONFIG_INFINIBAND=y
CONFIG_INFINIBAND_USER_ACCESS=y
CONFIG_RDMA_RXE=y
CONFIG_RDMA_SIW=y
