# kbuildlab preset, soft half: drivers for the devices `kbuildlab run --emulate`
# has QEMU put in the guest.  Each is emulated hardware, not a simulator: the
# guest sees a real controller model and the real driver runs against it, so
# every path from probe to interrupt is there to trace.  Applied like the rest
# of presets/soft (lib/softconfig.py): existing answers are never moved.

# --- buses and transports
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y

# --- storage: NVMe, AHCI, virtio-scsi and USB mass storage, each backed by a
# --- disk that exists only in QEMU
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y

# --- input: USB and virtio keyboards and tablets
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_VIRTIO_INPUT=y

# --- display, sound, crypto, memory
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_VIRTIO=y
CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_DEV_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y

# --- serial: a PCI 16550 and a virtio console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_VIRTIO_CONSOLE=y

# --- watchdog: QEMU is told to do nothing when it fires
CONFIG_WATCHDOG=y
CONFIG_I6300ESB_WDT=y

# --- CAN: an SJA1000 on a Kvaser PCI card and a CTU CAN FD, on a QEMU can-bus
CONFIG_CAN=y
CONFIG_CAN_DEV=y
CONFIG_CAN_SJA1000=y
CONFIG_CAN_KVASER_PCI=y
CONFIG_CAN_CTUCANFD_PCI=y

# --- network: an Intel e1000e beside the virtio NIC
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=y
