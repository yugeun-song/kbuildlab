# kbuildlab preset, soft half: drivers for the devices `kbuildlab run --emulate`
# has QEMU put in the guest.  Each is emulated hardware, not a simulator: the
# guest sees a real controller model and the real driver runs against it, so
# every path from probe to interrupt is there to trace.  Applied like the rest
# of presets/soft (lib/softconfig.py): existing answers are never moved.

# --- buses and transports
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y

# --- storage: NVMe, virtio-scsi and USB mass storage, each backed by a disk
# --- that exists only in QEMU
CONFIG_BLK_DEV_NVME=y
CONFIG_SCSI_VIRTIO=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y

# --- input: USB and virtio keyboards and tablets
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_VIRTIO_INPUT=y

# --- display, sound, crypto, memory
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y
CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_DEV_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y

# --- a virtio console
CONFIG_VIRTIO_CONSOLE=y

# --- CAN: a CTU CAN FD whose two channels share a QEMU can-bus
CONFIG_CAN=y
CONFIG_CAN_DEV=y
CONFIG_CAN_CTUCANFD_PCI=y

# --- SD/eMMC on a PCI SD host controller, and QEMU's usb-serial (an FTDI FT232)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
