# kbuildlab preset, storage half for STORAGE=emmc: the system disk is an eMMC
# behind a PCI SD host controller, the persistent disk an SD card behind
# another.  Hard, because the root file system is mounted before a module can
# be loaded.
CONFIG_PCI=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_EXT4_FS=y
# The boot partition is FAT, and the rootfs reads it (the modules archive) before
# any module is loaded: vfat with the code page and the charset it mounts with.
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
