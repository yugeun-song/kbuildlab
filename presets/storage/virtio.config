# kbuildlab preset, storage half for STORAGE=virtio: the system disk is a virtio
# block device.  Hard, because the root file system is mounted before a module can
# be loaded.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
# The boot partition is FAT, and the rootfs reads it (the modules archive) before
# any module is loaded: vfat with the code page and the charset it mounts with.
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
