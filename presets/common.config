# kbuildlab: maximum-debuggability kernel preset, shared half.
#
# Verified against Linux 6.12.103.  Every line here is a symbol with a real
# prompt: promptless symbols (DEBUG_INFO, BPF, BPF_EVENTS, TRACING, RING_BUFFER,
# FTRACE_MCOUNT_RECORD, PAHOLE_*, ARCH_WANT_FRAME_POINTERS ...) are deliberately
# absent, because `make olddefconfig` recomputes them from their selecters and a
# hand-written line for one is discarded without comment.  A fragment that looks
# like it set something and did not is worse than one that says nothing.
#
# Apply with scripts/kconfig/merge_config.sh, then `make olddefconfig`, then read
# the result back -- `kbuildlab preset verify` does that and fails on a symbol
# that a `depends on` swallowed.
#
# Options that must differ per architecture live in presets/arch/<arch>.config.
# Putting one of those here is the failure this layout exists to prevent.

# --- gates.  EXPERT selects DEBUG_KERNEL (init/Kconfig:1549) and unhides the
# --- debug-information choice; without it none of the DWARF options appear.
CONFIG_EXPERT=y
CONFIG_DEBUG_KERNEL=y

# --- debug information -------------------------------------------------------
# One member of the choice at lib/Kconfig.debug:240.  DWARF5 standardises the
# loclists/rnglists forms, which is exactly the encoding that lets gdb say "this
# variable lives in register X over PC range A..B" instead of giving up.
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_NONE is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set

# REDUCED is the single most damaging option for this preset's purpose: it adds
# -fno-var-tracking (scripts/Makefile.debug:26-31), which stops the compiler
# describing where a variable lives after optimisation, so locals that WOULD
# have been recoverable at -O2 print as <optimized out>.  On gcc it also adds
# -femit-struct-debug-baseonly, which guts struct layouts.
# CONFIG_DEBUG_INFO_REDUCED is not set
# SPLIT scatters DWARF into .dwo files that must stay reachable at the recorded
# build path, and hard-blocks BTF (lib/Kconfig.debug:379).
# CONFIG_DEBUG_INFO_SPLIT is not set
# Compression preserves information but costs a decompression pass on every
# symbol load.  Disk is the cheap resource here.
CONFIG_DEBUG_INFO_COMPRESSED_NONE=y
# CONFIG_DEBUG_INFO_COMPRESSED_ZLIB is not set
# CONFIG_DEBUG_INFO_COMPRESSED_ZSTD is not set

# BTF is what drgn, bpftrace and CO-RE BPF read.  gdb does not read it, so this
# buys nothing for `p`/`ptype`; it is here because those tools share the image.
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# CONFIG_MODULE_ALLOW_BTF_MISMATCH is not set
CONFIG_GDB_SCRIPTS=y

# --- symbols -----------------------------------------------------------------
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
# CONFIG_KALLSYMS_SELFTEST is not set
# CONFIG_STRIP_ASM_SYMS is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
CONFIG_VMLINUX_MAP=y
CONFIG_BUILTIN_MODULE_RANGES=y
CONFIG_MODULES=y

# --- the optimiser ceiling ---------------------------------------------------
# 6.12 offers -O2 or -Os and nothing else: the choice at init/Kconfig:1458 has
# exactly two members.  There is no -Og and no -O0.  What remains optimised out
# at -O2 is documented in docs/debuggability.md; it is not a configuration bug.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_LTO_NONE=y
CONFIG_RANDSTRUCT_NONE=y

# gcc-only levers that buy back some inlining and reordering.  Both carry
# `depends on CC_IS_GCC` and have no clang equivalent in 6.12, so this preset
# assumes gcc.  DEBUG_SECTION_MISMATCH adds -fno-inline-functions-called-once,
# READABLE_ASM adds -fno-reorder-blocks -fno-ipa-cp-clone -fno-partial-inlining.
CONFIG_DEBUG_SECTION_MISMATCH=y
CONFIG_SECTION_MISMATCH_WARN_ONLY=y
CONFIG_READABLE_ASM=y
# Those two flags shift which gcc warnings fire, and SECTION_MISMATCH_WARN_ONLY
# only covers modpost, not the compiler.  WERROR would turn a new warning into a
# failed build for a reason unrelated to the change being tested.
# CONFIG_WERROR is not set

# --- introspection surface ---------------------------------------------------
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_DEBUG_FS=y
CONFIG_STACKTRACE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_KGDB=y
CONFIG_KGDB_SERIAL_CONSOLE=y

# --- KASLR --------------------------------------------------------------------
# Built in (=y) so one build serves both: boot with `nokaslr` for deterministic
# addresses, or without it to exercise KASLR (gdbtools calibrates the slide via
# `kearly kaslr`). RANDOMIZE_MEMORY stays off (x86 arch fragment) for debugging.
CONFIG_RANDOMIZE_BASE=y

# --- tracing -----------------------------------------------------------------
# What every tool named "*trace" needs from the kernel, minus anything that is a
# self-test or a permanent tax.  "As many features as possible" means the
# capability is present and idle, not that every diagnostic is armed at boot.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_FUNCTION_GRAPH_RETVAL=y
CONFIG_FUNCTION_PROFILER=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_STACK_TRACER=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_HWLAT_TRACER=y
CONFIG_OSNOISE_TRACER=y
CONFIG_TIMERLAT_TRACER=y
CONFIG_SYNTH_EVENTS=y
# HIST_TRIGGERS is NOT here: it depends on ARCH_HAVE_NMI_SAFE_CMPXCHG,
# which riscv64 does not select.  It lives in the two arch fragments that
# can have it.  This is what the read-back check found.
CONFIG_RCU_TRACE=y
CONFIG_BLK_DEV_IO_TRACE=y
CONFIG_BRANCH_PROFILE_NONE=y

# probes.  PROBE_EVENTS_BTF_ARGS lets a probe name its arguments after the
# function's real parameters instead of $arg1, which is most of what makes
# bpftrace and `perf probe` readable.
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_PROBE_EVENTS_BTF_ARGS=y
CONFIG_PERF_EVENTS=y

# BPF.  The JIT is where XDP gets its speed; BTF is what makes CO-RE work.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_LSM=y
CONFIG_BPF_PRELOAD=y
CONFIG_BPF_PRELOAD_UMD=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# --- deliberately off --------------------------------------------------------
# Self-tests.  Their own help text carries the numbers.  FTRACE_STARTUP_TEST
# exercises every configured tracer in sequence on each boot and silently pulls
# EVENT_TRACE_STARTUP_TEST (default y under it), which fires every trace event in
# the system.  RING_BUFFER_STARTUP_TEST promises "+10 seconds" and, worse,
# disables ALL ring buffers on any anomaly -- one false positive leaves a
# tracing kernel that cannot trace.  Under QEMU TCG, multiply all of it.
# CONFIG_FTRACE_STARTUP_TEST is not set
# CONFIG_EVENT_TRACE_STARTUP_TEST is not set
# CONFIG_EVENT_TRACE_TEST_SYSCALLS is not set
# CONFIG_RING_BUFFER_STARTUP_TEST is not set
# CONFIG_FTRACE_SORT_STARTUP_TEST is not set
# CONFIG_KPROBE_EVENT_GEN_TEST is not set
# CONFIG_SYNTH_EVENT_GEN_TEST is not set
# CONFIG_PREEMPTIRQ_DELAY_TEST is not set
# CONFIG_MMIOTRACE_TEST is not set
# CONFIG_KALLSYMS_SELFTEST is not set

# Permanent taxes on the hottest paths, per their own help text.
# CONFIG_RING_BUFFER_VALIDATE_TIME_DELTAS is not set
# CONFIG_FTRACE_VALIDATE_RCU_IS_WATCHING is not set
# CONFIG_FTRACE_RECORD_RECURSION is not set
# CONFIG_RING_BUFFER_RECORD_RECURSION is not set
# CONFIG_PROFILE_ALL_BRANCHES is not set
# CONFIG_PROFILE_ANNOTATED_BRANCHES is not set
# CONFIG_BRANCH_TRACER is not set
# CONFIG_GCOV_PROFILE_FTRACE is not set
# CONFIG_RING_BUFFER_BENCHMARK is not set
# CONFIG_TRACE_EVAL_MAP_FILE is not set
# CONFIG_TRACE_EVENT_INJECT is not set

# Fault injection, not observability.  Both change what the kernel does.
# CONFIG_BPF_KPROBE_OVERRIDE is not set
# CONFIG_FUNCTION_ERROR_INJECTION is not set
# KPROBE_EVENTS_ON_NOTRACE risks infinite recursion and gains no capability.
# CONFIG_KPROBE_EVENTS_ON_NOTRACE is not set
