# Build environment for kernels and root filesystems.
#
# Plain OCI syntax, no builder extensions, so docker, podman, buildah and
# nerdctl all read this file unchanged.  Dockerfile beside it is a symlink for
# tools that look for that name first.
#
# The reason this exists: a rolling-release host moves its toolchain whenever it
# feels like it, and buildroot in particular breaks on new gcc long before the
# kernel does.  Pinning the build environment to a stable base decouples "what
# my laptop has today" from "what this kernel was built with".
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
# buildroot refuses to configure as root without this; the container IS root.
ENV FORCE_UNSAFE_CONFIGURE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates build-essential \
        git make binutils bc rsync patch wget curl cpio unzip file \
        tar gzip bzip2 xz-utils \
        libncurses-dev libssl-dev libelf-dev libcap-dev \
        flex bison kmod gawk texinfo pkg-config cmake \
        autoconf automake libtool gettext \
        perl python3 python-is-python3 locales sed bash findutils \
    && rm -rf /var/lib/apt/lists/*

# dwarves supplies pahole, which is what turns DWARF into BTF.  Without it
# CONFIG_DEBUG_INFO_BTF fails the build rather than quietly skipping, which is
# the behaviour we want -- the preset asks for BTF on purpose.
RUN apt-get update && apt-get install -y --no-install-recommends \
        dwarves clang llvm \
    && rm -rf /var/lib/apt/lists/*

# Source indexers for `kbuildlab tags`, in the same env as the build. GNU GLOBAL
# (gtags) is the symbolic index (kernel has a `make gtags` target); with clangd
# off, ctags+cscope+gtags are the navigation layer.
RUN apt-get update && apt-get install -y --no-install-recommends \
        universal-ctags cscope global \
    && rm -rf /var/lib/apt/lists/*

# Three compiler generations for every target, not one.
#
# A tree names the one it builds with (GCC= in its tree.conf); the image carries
# the range so raising or lowering a tree is a config edit, not an image rebuild.
# That matters because "the newest compiler" is not one answer across seven
# kernels: mainline tracks gcc head, an LTS stable series is validated against
# what shipped with it, and a 2016 kernel predates all of them.
#
# 26.04 packages gcc 11 through 16; the three newest are installed here, which is
# the range a kernel of any age in this workspace needs.  15 is the default and newest
# RELEASE; 16 is a dated development snapshot (16-2026MMDD, no .0), so it is
# installed and reachable but is not what /usr/bin/gcc points at.  A tree opting
# into it is opting into a prerelease compiler, deliberately.
#
# 32-bit runtimes come along for each: arch/x86/boot builds -m32, and a
# multilib package tracks its own compiler version, so pinning gcc without it
# leaves `gcc -m32` reaching for another compiler's headers.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-14 g++-14 gcc-14-multilib g++-14-multilib \
        gcc-15 g++-15 gcc-15-multilib g++-15-multilib \
        gcc-16 g++-16 gcc-16-multilib g++-16-multilib \
        gcc-14-aarch64-linux-gnu g++-14-aarch64-linux-gnu \
        gcc-15-aarch64-linux-gnu g++-15-aarch64-linux-gnu \
        gcc-16-aarch64-linux-gnu g++-16-aarch64-linux-gnu \
        gcc-14-riscv64-linux-gnu g++-14-riscv64-linux-gnu \
        gcc-15-riscv64-linux-gnu g++-15-riscv64-linux-gnu \
        gcc-16-riscv64-linux-gnu g++-16-riscv64-linux-gnu \
        binutils-aarch64-linux-gnu binutils-riscv64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# The unversioned names resolve to 15 -- the newest release, and what a tree
# that states no GCC= gets.  Every other version stays reachable by its own
# name, which is how a tree pins one.
#
# The note at the top of this file is not idle: buildroot breaks on new
# compilers well before the kernel does, so if a rootfs build fails here, point
# it at an older one (HOSTCC=gcc-14) rather than moving the whole image back.
RUN ln -sf gcc-15 /usr/bin/gcc && ln -sf g++-15 /usr/bin/g++ \
    && ln -sf aarch64-linux-gnu-gcc-15 /usr/bin/aarch64-linux-gnu-gcc \
    && ln -sf aarch64-linux-gnu-g++-15 /usr/bin/aarch64-linux-gnu-g++ \
    && ln -sf riscv64-linux-gnu-gcc-15 /usr/bin/riscv64-linux-gnu-gcc \
    && ln -sf riscv64-linux-gnu-g++-15 /usr/bin/riscv64-linux-gnu-g++

# `install` must be GNU coreutils', not uutils'.
#
# Ubuntu 26.04 makes uutils coreutils the default and leaves GNU's at
# /usr/bin/gnuinstall.  buildroot checks for this at
# support/dependencies/dependencies.mk and REFUSES to start, naming
# uutils/coreutils#12166 -- so a rootfs build here stops before it does anything,
# with an error about the host tool rather than about the build.  The image is
# where a host tool is chosen, so the choice belongs here.
#
# Asked rather than assumed: if a future image no longer has gnuinstall, or
# already points install at GNU's, this changes nothing and says so, instead of
# creating a dangling symlink that would break every package that installs
# anything.
RUN if [ -x /usr/bin/gnuinstall ] && install --version 2>/dev/null | grep -qi uutils; then \
        update-alternatives --install /usr/bin/install install /usr/bin/gnuinstall 100 \
        && update-alternatives --set install /usr/bin/gnuinstall; \
        echo "install -> $(readlink -f "$(command -v install)")"; \
    else \
        echo "install is already $(install --version 2>/dev/null | head -1)"; \
    fi

RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

WORKDIR /workspace
CMD ["/bin/bash"]
