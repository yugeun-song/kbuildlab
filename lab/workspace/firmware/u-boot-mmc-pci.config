# eMMC behind a PCI SD host controller (QEMU sdhci-pci), merged over the stock
# QEMU defconfig by build-uboot.sh, plus the boot devices that must stay.
# PIO only. SDMA and 32-bit ADMA2 carry 32-bit DMA addresses, but on QEMU U-Boot
# relocates to the top of RAM, above 4 GiB once arm64 has -m > 3G or riscv64
# -m > 2G. 64-bit ADMA2 needs a capability bit sdhci-pci leaves clear by default,
# and SDMA together with ADMA misprograms the controller (drivers/mmc/sdhci.c).
CONFIG_MMC=y
CONFIG_DM_MMC=y
CONFIG_MMC_PCI=y
CONFIG_MMC_SDHCI=y
# CONFIG_MMC_SDHCI_SDMA is not set
# CONFIG_MMC_SDHCI_ADMA is not set
CONFIG_CMD_MMC=y
CONFIG_PCI=y
CONFIG_PCI_INIT_R=y
CONFIG_NVME_PCI=y
CONFIG_CMD_NVME=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EFI_PARTITION=y
