# qemu-riscv's distro boot_targets has no mmc0. Put it in front at preboot (after
# the stock preboot) so the unchanged "run distro_bootcmd" tries the eMMC first.
# "mmc list" probes the SD hosts behind PCI first; distro boot's "mmc dev" alone
# finds no device at slot 0 while they are still unprobed.
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv fdt_addr ${fdtcontroladdr}; fdt addr ${fdtcontroladdr}; mmc list; setenv bootcmd_mmc0 'devnum=0; run mmc_boot'; setenv boot_targets mmc0 ${boot_targets}"
