#!/usr/bin/env bash
# kbuildlab -- build a Linux kernel in a container, boot it in QEMU, debug it.
#
# One entry point.  Every subcommand resolves the tree the same way and
# validates what it was handed before doing anything.
set -uo pipefail

_self="$(readlink -f "${BASH_SOURCE[0]}")"
KBL_REPO="$(cd -P "$(dirname "$_self")/.." && pwd)"
# shellcheck source=/dev/null
source "${KBL_REPO}/lib/common.sh"
# shellcheck source=/dev/null
source "${KBL_REPO}/lib/registry.sh"

KBL_DEFAULT_VERSION="v6.18"
KBL_IMAGE="${KBL_IMAGE:-kbuildlab:latest}"
KBL_LEGACY_IMAGE="${KBL_LEGACY_IMAGE:-kbuildlab-legacy:latest}"
STABLE_URL="${KBL_STABLE_URL:-https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git}"
MAINLINE_URL="${KBL_MAINLINE_URL:-https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git}"
# Where every tree's definition is recorded: in this repository, so a deleted
# workspace or a new machine loses no answer (see _record).
KBL_LAB="${KBL_LAB:-${KBL_REPO}/lab}"
# The records exist to be pushed, and GitHub refuses any file over 100 MiB; a
# text file that large at the top of the workspace is generated, not written.
KBL_GITHUB_FILE_LIMIT=$((100 * 1024 * 1024))

# shellcheck source=/dev/null
source "${KBL_REPO}/lib/build.sh"
# shellcheck source=/dev/null
source "${KBL_REPO}/lib/lab.sh"
# shellcheck source=/dev/null
source "${KBL_REPO}/lib/tags.sh"
# shellcheck source=/dev/null
source "${KBL_REPO}/lib/update.sh"
# shellcheck source=/dev/null
source "${KBL_REPO}/lib/host.sh"

usage() {
    cat <<USAGE
kbuildlab -- register, build, boot and debug Linux kernel trees

Trees (any directory, any time):
  kbuildlab trees [-q|--json|--narrow]      every registered tree: kernel, commit,
                                            build state, running guests, source;
                                            --narrow prints one block per tree
  kbuildlab inspect TREE [--json|--format K]  everything known about one tree
  kbuildlab add DIR [--name N] [--arch A]   register a kernel source you already have
  kbuildlab init NAME --arch ARCH [--version V] [--src DIR]
                                            register a new tree, to clone with sync
                                            (default $KBL_DEFAULT_VERSION, into the workspace)
  kbuildlab init NAME                       recreate a tree recorded in lab/trees
  kbuildlab init --restore                  recreate the recorded workspace and trees
  kbuildlab init --workspace DIR            record where new trees are cloned
  kbuildlab get TREE [KEY...]               read its tree.conf (all of it, or keys)
  kbuildlab set TREE KEY=VALUE...           write keys into its tree.conf
  kbuildlab unset TREE KEY...               remove keys from its tree.conf
  kbuildlab edit TREE                       open its tree.conf in \$VISUAL / \$EDITOR
  kbuildlab mv TREE DIR [--no-move]         move its source (or only repoint SRC)
  kbuildlab rename OLD NEW                  rename a tree
  kbuildlab rm TREE [--purge] [--yes]       unregister; --purge also deletes the
                                            source, its data and its indexes
  kbuildlab prune [--yes]                   drop trees whose source is gone and data
                                            no tree owns
  kbuildlab migrate [--dry-run]             move trees that keep tree.conf beside
                                            their source into the registry

Build:
  kbuildlab update [TREE...|--all] [--no-tags] [--no-clangd] [--no-warm]
                                            one pass: check, sync, keep .config
                                            (olddefconfig + report), incremental
                                            build, modules, ctags/cscope/gtags,
                                            clangd -- then a summary
  kbuildlab sync   [TREE]                   fetch, and fast-forward to the newest
                                            patch level of the tracked version
  kbuildlab config [TREE] [--preset]        apply the debuggability preset; its soft
                                            half adds simulated and emulated devices
                                            and their tracing without moving an
                                            existing answer
  kbuildlab build  [TREE] [-- MAKE ARGS]    build in the container
  kbuildlab tags   [TREE] [--no-clangd]     refresh ctags, cscope, gtags and the
                          [--clangd-only]     clangd index (KBL_CLANGD=0,
                          [--no-warm]         KBL_CLANGD_WARM=0 turn clangd off)
  kbuildlab image  [legacy]                 build the container image

Run and debug:
  kbuildlab run    [TREE] [QEMU ARGS]       boot it, frozen for a debugger; Ctrl-C
                                            goes to the guest, Ctrl-A X quits qemu
                                            (--run, --no-initrd, --append, --emulate,
                                             --mem, --smp, --kaslr, --boot)
  kbuildlab attach [TREE] [--port N]        attach gdb to a running guest, stopped
                                            at head.S _text (--no-bootbreak, --list,
                                            --first, --json for the session spec)
  kbuildlab drgn   [TREE] [--qmp-port N]    attach drgn over QMP
  kbuildlab resume [TREE] [--port N]        resume a guest a dead debugger left paused

Host:
  kbuildlab doctor                          what is installed, and what is missing
  kbuildlab containers [status|clean]       what the container runtime holds
  kbuildlab help COMMAND                    one command's options (COMMAND --help
                                            says the same)

ARCH is one of: arm64, riscv64, x86_64.
TREE is a registered name, or a path inside a registered source (or the
directory holding one); omitted, it is the tree the current directory belongs
to, else the only one registered.  rm, mv and rename take a name only.
Tab completes commands, options, trees and live guests' ports once install.sh
has put the bash and zsh completions in place.
USAGE
}

# ---------------------------------------------------------------- run / attach
cmd_run()    { exec "${KBL_REPO}/lib/run-qemu.sh" "$@"; }
cmd_attach() { exec "${KBL_REPO}/lib/run-gdb.sh" "$@"; }
cmd_drgn()   { exec "${KBL_REPO}/lib/run-drgn.sh" "$@"; }
cmd_resume() { exec "${KBL_REPO}/lib/resume.sh" "$@"; }

# ---------------------------------------------------------------- help
# One command's options come from lib/cli.py, which the shell completions also
# read; run, attach, drgn and resume print their own.  -h or --help anywhere
# before a `--` asks for it, so a half-typed command answers instead of running.
_kbl_cli() { python3 "${KBL_REPO}/lib/cli.py" "$@"; }
_kbl_wants_help() {
    local a
    for a in "$@"; do
        [[ "$a" == -- ]] && return 1
        [[ "$a" == -h || "$a" == --help ]] && return 0
    done
    return 1
}
cmd_help() {
    [[ $# -gt 0 ]] || { usage; return 0; }
    case "$1" in
        run|attach|drgn|resume) "cmd_$1" --help ;;
        *) _kbl_cli help "$1" ;;
    esac
}

# ---------------------------------------------------------------- dispatch
# Braced and ended with exit, so bash has read all of it before running any:
# editing this file during a long update cannot change what runs after it.
{
cmd="${1:-help}"; shift || true
case "$cmd" in
    run|attach|drgn|resume|help|-h|--help|__complete) ;;
    *) if _kbl_wants_help "$@"; then _kbl_cli help "$cmd"; exit; fi ;;
esac
case "$cmd" in
    init)   cmd_init "$@" ;;
    image)  cmd_image "$@" ;;
    sync)   cmd_sync "$@" ;;
    config) cmd_config "$@" ;;
    build)  cmd_build "$@" ;;
    tags)   cmd_tags "$@" ;;
    update) cmd_update "$@" ;;
    run)    cmd_run "$@" ;;
    attach) cmd_attach "$@" ;;
    drgn)   cmd_drgn "$@" ;;
    resume) cmd_resume "$@" ;;
    trees|ls) cmd_trees "$@" ;;
    inspect) cmd_inspect "$@" ;;
    add)    cmd_add "$@" ;;
    rm)     cmd_rm "$@" ;;
    mv)     cmd_mv "$@" ;;
    rename) cmd_rename "$@" ;;
    get)    cmd_get "$@" ;;
    set)    cmd_set "$@" ;;
    unset)  cmd_unset "$@" ;;
    edit)   cmd_edit "$@" ;;
    prune)  cmd_prune "$@" ;;
    migrate) cmd_migrate "$@" ;;
    containers) cmd_containers "$@" ;;
    doctor) cmd_doctor ;;
    help|-h|--help) cmd_help "$@" ;;
    __complete) _kbl_cli complete "$@" ;;
    *) echo "kbuildlab: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
exit
}
